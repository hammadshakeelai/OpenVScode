<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark">
    <LinearLayout android:id="@+id/editorContainer" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:paddingHorizontal="8dp" android:gravity="center_vertical" android:background="@color/toolbar_bg">
            <TextView android:id="@+id/editorLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="OpenVScode" android:textSize="14sp"
                android:textColor="@color/white" android:paddingStart="8dp" android:paddingEnd="4dp" />
            <Button android:id="@+id/sessionButton" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="Session"
                android:textAllCaps="false" android:textColor="@color/accent_blue" />
        </LinearLayout>
        <FrameLayout android:id="@+id/webContainer" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" />
        <HorizontalScrollView android:id="@+id/keyboardToolbar" android:layout_width="match_parent"
            android:layout_height="52dp" android:background="@color/toolbar_bg" android:scrollbars="none"
            android:fillViewport="true" android:paddingHorizontal="4dp">
            <LinearLayout android:id="@+id/keysContainer" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>
    <ScrollView android:id="@+id/setupScroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/setupContent" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_launcher"
                    android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                    android:text="OpenVScode" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/white" />
            </LinearLayout>
            <TextView android:id="@+id/eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:text="YOUR PHONE. YOUR WORKSPACE." android:textSize="11sp"
                android:letterSpacing="0.12" android:textColor="@color/accent_blue" />
            <TextView android:id="@+id/statusTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Let’s get you\ncoding." android:textColor="@color/white"
                android:textSize="34sp" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="1dp" />
            <TextView android:id="@+id/statusSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="VS Code, a terminal, Python and C++ on your Android. We’ll walk you through the setup."
                android:textColor="@color/key_btn_text" android:textSize="15sp" android:lineSpacingExtra="4dp" />
            <LinearLayout android:id="@+id/stepsContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:orientation="vertical" android:padding="16dp"
                android:background="@drawable/setup_panel" />
            <LinearLayout android:id="@+id/detailContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="20dp" />
            <ProgressBar android:id="@+id/installProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="20dp"
                android:progressTint="@color/accent_blue" android:indeterminateTint="@color/accent_blue" android:visibility="gone" />
            <TextView android:id="@+id/progressCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textSize="12sp" android:textColor="@color/key_btn_text" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/primaryButton"
                android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp"
                android:text="Get started" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/bg_dark" android:backgroundTint="@color/accent_blue" />
            <com.google.android.material.button.MaterialButton android:id="@+id/secondaryButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent"
                android:layout_height="56dp" android:textAllCaps="false" android:textSize="14sp"
                android:textColor="@color/accent_blue" android:visibility="gone" />
            <TextView android:id="@+id/setupFootnote" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="One-time setup · No root needed" android:textColor="@color/text_hint"
                android:textSize="12sp" android:gravity="center" />
            <Button android:id="@+id/remoteButton" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp"
                android:text="Use an existing server" android:textAllCaps="false" android:textColor="@color/key_btn_text" />
            <Button android:id="@+id/helpButton" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="48dp" android:text="Help &amp; diagnostics"
                android:textAllCaps="false" android:textColor="@color/text_hint" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

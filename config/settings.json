{
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.layoutControl.enabled": true,

  "// Mobile Screen Real-Estate Optimizations": "",
  "editor.minimap.enabled": false,
  "editor.glyphMargin": false,
  "editor.folding": true,
  "editor.wordWrap": "on",
  "editor.fontSize": 14,
  "editor.lineHeight": 22,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.mouseWheelZoom": true,

  "// Android Background Safety (Never lose edits if OS kills background tab)": "",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,

  "// Python Configuration": "",
  "python.defaultInterpreterPath": "/data/data/com.termux/files/usr/bin/python",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,

  "// C / C++ (Clangd) Configuration for Mobile ARM64": "",
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--header-insertion=never",
    "-j=2"
  ],

  "// Jupyter Notebook Settings": "",
  "jupyter.askForKernelRestart": false,
  "notebook.lineNumbers": "on",
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "right"
  },

  "// Code Runner (1-Click Run Button in Navigation Bar)": "",
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.executorMap": {
    "python": "python3 -u",
    "c": "clang -std=c17 $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt",
    "cpp": "clang++ -std=c++20 $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt"
  },

  "// Terminal Mobile Optimizations": "",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 1000
}
